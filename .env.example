# ---------------------------------------------------------------------------
# 파이어베이스 설정
#
# 이 파일을 복사해서 ".env" 라는 이름으로 만들고, 아래 값들을 채우세요.
#   cp .env.example .env
#
# 값 찾는 곳: 파이어베이스 콘솔 → 프로젝트 설정(⚙️) → 일반 → 내 앱 → SDK 설정 및 구성
# → "구성(Config)"을 고르면 firebaseConfig 객체가 나옵니다. 거기 값을 그대로 옮기면 됩니다.
#
# 이 값들은 브라우저에 노출되는 "공개 키"라서 비밀이 아닙니다. 실제 보안은
# firestore.rules(보안 규칙)가 담당합니다. 그래도 .env는 깃에 올리지 않습니다.
#
# ★ 이 파일을 안 만들어도 게임은 그대로 돌아갑니다.
#   로그인·클라우드 세이브·랭킹만 꺼지고, 진행상황은 이 브라우저에만 저장됩니다.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=여기에_apiKey
VITE_FIREBASE_AUTH_DOMAIN=여기에_authDomain
VITE_FIREBASE_PROJECT_ID=여기에_projectId
VITE_FIREBASE_STORAGE_BUCKET=여기에_storageBucket
VITE_FIREBASE_MESSAGING_SENDER_ID=여기에_messagingSenderId
VITE_FIREBASE_APP_ID=여기에_appId

# ---------------------------------------------------------------------------
# 멀티플레이 서버 주소 (선택 사항)
#
# 게임 화면의 "🌐 멀티플레이" 패널에 접속할 때 기본으로 채워지는 값입니다.
# 값을 안 넣어도 됩니다 — 패널을 열면 주소 입력칸에 직접 입력할 수 있습니다.
# 서버는 이 값과 별개로 따로 켜야 합니다: `npm run server` (README "멀티플레이 · PvP" 참고).
#
# 로컬 테스트: ws://localhost:8787
# 실제로 인터넷 너머로 열어둔 서버라면 wss:// 로 시작하는 주소를 넣으세요.
# ---------------------------------------------------------------------------
VITE_MULTIPLAYER_URL=ws://localhost:8787

# ---------------------------------------------------------------------------
# 자동 접속 (선택 사항, 배포용)
#
# 이 값을 "1"로 설정하면, 게임이 뜨자마자(패널을 열지 않아도) 위
# VITE_MULTIPLAYER_URL 서버로 자동 접속합니다. 로컬 개발 중에는 서버를 늘
# 켜두는 게 아니라서 기본값(비워둠)을 권장하고, Netlify처럼 서버 주소가
# 항상 켜져 있는 배포 환경에서만 켜세요 (Netlify 사이트 설정 → Environment
# variables 에 VITE_MULTIPLAYER_URL과 함께 추가).
# ---------------------------------------------------------------------------
VITE_MULTIPLAYER_AUTOCONNECT=

# 멀티플레이 서버 자체의 포트 (선택 사항, 기본 8787). `npm run server`를 실행할 때
# 셸에서 PORT=... npm run server 처럼 넘겨도 되고, 이 파일에 적어둬도 됩니다.
PORT=8787
