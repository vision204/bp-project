rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore 보안 규칙
//
// 파이어베이스 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 "게시"를 누르세요.
// (기본 규칙은 30일 뒤 전부 막히거나 아무나 쓸 수 있는 상태라, 반드시 바꿔야 합니다)
//
// 이 파일은 실제로 배포되는 규칙이 아니라(파이어베이스 콘솔에서 직접 게시해야
// 적용됩니다) 저장소에 같이 버전 관리하기 위한 사본입니다. 콘솔의 규칙을
// 바꿀 때는 이 파일도 같이 갱신해 주세요.
//
// 핵심 원칙
//   · 세이브는 **본인만** 읽고 쓸 수 있습니다.
//   · 랭킹은 **로그인한 사람은 모두 볼 수 있고, 자기 줄만** 쓸 수 있습니다.
//   · 이름·레벨 같은 값의 타입과 범위를 검사해서 이상한 데이터가 안 들어가게 합니다.
//   · 랭킹 문서는 정확히 정해진 필드만 허용합니다(엉뚱한 필드를 끼워 넣지 못하도록).
//
// ⚠️ 한계: 이 규칙은 "남의 데이터를 건드리는 것"은 막지만, 브라우저를 조작해
//    자기 레벨을 부풀려 올리는 것까지 막지는 못합니다. 그건 서버(Cloud Functions)에서
//    검증해야 하는 일이라, 정식 서비스로 갈 때 붙이는 걸 권합니다.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // 세이브 — 본인만
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 랭킹 — 로그인한 사람은 모두 볼 수 있고, 자기 줄만 쓸 수 있습니다
    match /leaderboard/{uid} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // 앱이 실제로 쓰는 필드만 정확히 허용 — 엉뚱한 필드가 끼어들지 못하게
                   && request.resource.data.keys().hasOnly(
                        ['name', 'faction', 'level', 'money', 'fruitLevel', 'uid', 'updatedAt'])
                   // uid 필드는 문서 id와 반드시 같아야 함(화면은 문서 id를 쓰지만, 데이터가
                   // 서로 어긋나 있는 것 자체를 막습니다)
                   && request.resource.data.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 40
                   && request.resource.data.level is int
                   && request.resource.data.level >= 1
                   && request.resource.data.level <= 2000
                   && request.resource.data.money is int
                   && request.resource.data.money >= 0
                   && request.resource.data.fruitLevel is int
                   && request.resource.data.fruitLevel >= 1
                   && request.resource.data.fruitLevel <= 100
                   && request.resource.data.faction in ['pirate', 'marine'];
    }

    // 그 외에는 전부 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
